<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- xUnit + Shouldly + NSubstitute per testing.md. NSubstitute arrived with the
       first collaborator worth faking: ISeriesMetadataSource, so the add-series
       idempotency test never touches the network. The in-memory EF provider gives
       that test a database without Postgres; it is a test double for the store,
       not a second supported provider. -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- Captured AniList responses (testing.md #4). Copied rather than embedded so
       the files stay browsable next to the tests that read them. -->
  <ItemGroup>
    <Content Include="Features\Metadata\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The owner's StoryGraph export, anonymised (StoryGraphExportFixture says how).
       Every parsing oddity asserted in the import tests came out of this file. -->
  <ItemGroup>
    <Content Include="Features\Import\Fixtures\story-graph-export.csv"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The host's real configuration files, linked rather than copied so this project
       cannot drift from what actually ships. OptionsValidationTests reads these to catch a
       value that parses but binds to something startup validation would refuse — a
       CacheDuration written "24:00:00" (24 days, not one) was exactly that shape of bug. -->
  <ItemGroup>
    <Content Include="..\LnShelf.Api\appsettings.json"
             Link="Fixtures\appsettings.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\LnShelf.Api\appsettings.Development.json"
             Link="Fixtures\appsettings.Development.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The Goodreads export is synthetic, and says so in GoodreadsExportFixture:
       no real one exists in the repo, so it is built from the published column
       list rather than captured. It lives here rather than in docs/ precisely so
       it is not mistaken for the owner's own data. -->
  <ItemGroup>
    <Content Include="Features\Import\Fixtures\goodreads-export.csv"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LnShelf.Api\LnShelf.Api.csproj" />

    <!-- The client is referenced only so its pure logic (popover placement) can be
         asserted without a browser. This does not weaken the client's own boundary:
         the arrow points inward, so nothing is added to the browser bundle. -->
    <ProjectReference Include="..\LnShelf.Client\LnShelf.Client.csproj" />
  </ItemGroup>

</Project>
