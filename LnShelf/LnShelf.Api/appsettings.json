{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Import": {
    "CandidatesPerGroup": 5,
    "AutoMatchMinimumScore": 92,
    "AutoMatchMinimumMargin": 8,
    "CandidateMinimumScore": 55
  },

  "Sync": {
    "Enabled": false,
    "Hour": 4
  },

  "MangaUpdates": {
    "Endpoint": "https://api.mangaupdates.com/v1/",
    "RequestsPerMinute": 60,
    "SearchResultLimit": 5,
    "AutoLinkMinimumScore": 92,
    "AutoLinkMinimumMargin": 8,
    "CacheDuration": "01:00:00",
    "RequestTimeout": "00:00:20",
    "MaximumRetryDelay": "00:01:00"
  },

  "OpenLibrary": {
    "Endpoint": "https://openlibrary.org/",
    "CoverEndpoint": "https://covers.openlibrary.org/",
    "ContactEmail": "",
    "RequestsPerMinute": 12,
    "SearchResultLimit": 5,
    "CandidateIsbnLimit": 8,
    "MaximumLookupsPerRun": 60,
    "MaximumLookupsOnDemand": 8,
    "CacheDuration": "1.00:00:00",
    "RequestTimeout": "00:00:30",
    "MaximumRetryDelay": "00:01:00"
  },

  "AppleBooks": {
    "Endpoint": "https://itunes.apple.com/",
    "RequestsPerMinute": 20,
    "SearchLimit": 200,
    "CacheDuration": "1.00:00:00",
    "RequestTimeout": "00:00:30",
    "MaximumRetryDelay": "00:01:00"
  },

  "AniList": {
    "Endpoint": "https://graphql.anilist.co/",
    "RequestsPerMinute": 30,
    "SearchResultLimit": 20,
    "CacheDuration": "01:00:00",
    "MaximumRetryDelay": "00:01:00",
    "RequestTimeout": "00:00:20"
  }
}
