{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Db": "Host=localhost;Port=5433;Database=lnshelf;Username=lnshelf;Password=lnshelf"
  },

  // Relative to the API project; .data/ is git-ignored. Production keeps covers in a
  // Docker volume at /data/covers, the option's default.
  "Covers": {
    "FileSystem": {
      "RootPath": ".data/covers"
    }
  },
  "Development": {
    "ClientOrigin": "http://localhost:5081"
  },

  // Signed in as the owner on every request, with no provider configured. Refused at
  // startup outside Development (AuthOptionsValidator). Set it to false and put
  // Auth:ClientId and Auth:ClientSecret in user-secrets to try the
  // real login locally.
  "Auth": {
    "DevelopmentBypass": true
  }
}
