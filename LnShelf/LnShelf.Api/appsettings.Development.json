{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Db": "Host=localhost;Port=5433;Database=lnshelf;Username=lnshelf;Password=lnshelf"
  },

  // The local compose credentials, matching docker-compose.yml's own note that
  // they are development-only. Production supplies these as environment
  // variables (feature-spec §9).
  "Covers": {
    "AccessKey": "lnshelf",
    "SecretKey": "lnshelf-dev-secret"
  },
  "Development": {
    "ClientOrigin": "http://localhost:5081"
  },

  // Signed in as the owner on every request, with no provider configured. Refused at
  // startup outside Development (AuthOptionsValidator). Set it to false and put
  // Auth:ClientId, Auth:ClientSecret and Auth:AllowedEmail in user-secrets to try the
  // real login locally.
  "Auth": {
    "DevelopmentBypass": true
  }
}
