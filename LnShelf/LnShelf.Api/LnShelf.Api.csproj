<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- TargetFramework, nullable and warnings-as-errors come from Directory.Build.props.
       No Microsoft.AspNetCore.OpenApi: nothing in scope needs a schema document, and
       the package pulls a Microsoft.OpenApi build with a published advisory (NU1903),
       which warnings-as-errors would rightly fail on. -->

  <ItemGroup>
    <!-- Referenced explicitly, not just transitively through Npgsql: this project
         uses EF Core directly, and pinning it here keeps one EF version across the
         solution (Npgsql 10.0.3 would otherwise pull 10.0.4 into the test project
         while Design pulled 10.0.10). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <!-- HybridCache. 10.8.0 depends on Microsoft.Extensions.* 10.0.10, which is
         the version EF Core already pulls, so the graph stays on one set. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.8.0" />

    <!-- CsvHelper for the StoryGraph export: quoted fields with embedded commas
         are exactly the thing not to hand-roll. No dependencies of its own. -->
    <PackageReference Include="CsvHelper" Version="33.1.0" />

    <!-- Cover normalization (feature-spec §4.3: cap dimensions, re-encode to webp,
         strip metadata). ImageSharp is under the Six Labors Split License, which is
         free for this project's use; it is the only practical option, since
         System.Drawing is Windows-only and the app ships in Linux containers. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />

    <!-- MinIO is ICoverStore's first implementation (feature-spec §3). It is the
         one dependency here that drags transitives (System.Reactive among them);
         the seam is what makes swapping it a config-and-class change. -->
    <PackageReference Include="Minio" Version="6.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LnShelf.Shared\LnShelf.Shared.csproj" />
  </ItemGroup>

  <!-- The development fixture. Embedded as a link rather than copied so
       docs/seed-library.json stays the single source and cannot drift. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\seed-library.json" LogicalName="LnShelf.Api.seed-library.json" />
  </ItemGroup>

</Project>
