@using LnShelf.Client.Features.Library

<aside class="sidebar">

    <div class="brand">
        <span class="brand__mark"><Icon Name="IconName.Books" Size="12" /></span>
        <span class="brand__name">LN Shelf</span>
    </div>

    <nav class="nav">
        <NavLink class="nav__row" ActiveClass="nav__row--active" href="" Match="NavLinkMatch.All">
            <Icon Name="IconName.Books" Size="15" />
            <span>Library</span>
        </NavLink>

        @* Not in the v2 mockup's nav, which predates the import flow existing.
           It is a real page with a real route, so it gets a real row. *@
        <NavLink class="nav__row" ActiveClass="nav__row--active" href="search">
            <Icon Name="IconName.MagnifyingGlass" Size="15" />
            <span>Search &amp; add</span>
        </NavLink>

        <NavLink class="nav__row" ActiveClass="nav__row--active" href="import">
            <Icon Name="IconName.FileArrowUp" Size="15" />
            <span>Import</span>
        </NavLink>

        @* Upcoming and Stats exist in the design but not yet in the app. Shown
           dimmed rather than hidden so the nav does not change shape when they
           land. No tooltip: hover-only information is exactly what design.md
           forbids, and the dimming is the visible channel. *@
        <span class="nav__row nav__row--pending" aria-disabled="true">
            <Icon Name="IconName.CalendarBlank" Size="15" />
            <span>Upcoming</span>
        </span>
        <span class="nav__row nav__row--pending" aria-disabled="true">
            <Icon Name="IconName.ChartBar" Size="15" />
            <span>Stats</span>
        </span>
    </nav>

    <div class="shelves">
        <p class="eyebrow">Shelves</p>
        @if (Shelves is not null)
        {
            @foreach (var shelf in Shelves)
            {
                @* The tint is the visible channel; aria-pressed is the spoken one —
                   the shelf rows are the same filter control as the status chips. *@
                <button type="button"
                        class="shelf @(LibraryState.SelectedFilter == shelf.Filter ? "shelf--active" : null) @(shelf.IsAttention ? "shelf--attention" : null)"
                        aria-pressed="@((LibraryState.SelectedFilter == shelf.Filter).ToAriaState())"
                        @onclick="() => LibraryState.SelectFilterAsync(shelf.Filter)">
                    <span class="shelf__label">@shelf.Label</span>
                    <span class="shelf__count tabular">@shelf.Count@(shelf.CountSuffix)</span>
                </button>
            }
        }
    </div>

    <div class="sync">
        <p class="eyebrow">Sync</p>
        @* Transparent, not magical (design.md): every line here is a number the run
           actually produced, including the line about what it could not do. *@
        @if (LatestSync is { } latest)
        {
            <p class="sync__line">Synced @latest.SyncedAtLabel</p>
            @foreach (var line in SummaryLines)
            {
                <p class="sync__line">@line</p>
            }
        }
        else
        {
            <p class="sync__line">Not synced yet</p>
            <p class="sync__line">Nothing has been refreshed against a release source</p>
        }
    </div>

    @* Quiet on purpose — a real page with a real route, but not a shelf-navigation
       row, so it sits below the sync panel rather than in .nav with Library/Search/Import. *@
    <div class="foot">
        <NavLink class="foot__link" href="changelog">Changelog</NavLink>
    </div>

</aside>
