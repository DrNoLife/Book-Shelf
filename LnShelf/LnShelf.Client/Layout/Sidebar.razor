@using LnShelf.Client.Features.Library
@using LnShelf.Client.Features.Sync

<aside class="sidebar">

    <div class="brand">
        <span class="brand__mark"><Icon Name="IconName.Books" Size="16" /></span>
        <span class="brand__name">LN Shelf</span>
    </div>

    <nav class="nav" aria-label="Main">
        <NavLink class="nav__row" ActiveClass="nav__row--active" href="" Match="NavLinkMatch.All">
            <Icon Name="IconName.Books" Size="16" />
            <span class="nav__label">Library</span>
        </NavLink>

        @* Import is the second tab of Search & add (/search/import), so this row is lit there
           too, and it carries the import queue's count: the count is what makes series the
           matcher could not place findable without opening the page. *@
        <NavLink class="nav__row" ActiveClass="nav__row--active" href="search">
            <Icon Name="IconName.MagnifyingGlass" Size="16" />
            <span class="nav__label">Search &amp; add</span>
            @if (ReviewCount > 0)
            {
                <Pill Tone="PillTone.Attention">@ReviewCount to review</Pill>
            }
        </NavLink>

        <NavLink class="nav__row" ActiveClass="nav__row--active" href="upcoming">
            <Icon Name="IconName.CalendarBlank" Size="16" />
            <span class="nav__label">Upcoming</span>
        </NavLink>

        <NavLink class="nav__row" ActiveClass="nav__row--active" href="stats">
            <Icon Name="IconName.ChartBar" Size="16" />
            <span class="nav__label">Stats</span>
        </NavLink>
    </nav>

    <div class="shelves">
        <p class="eyebrow">Smart shelves</p>
        @if (Shelves is not null)
        {
            @foreach (var shelf in Shelves)
            {
                @* The tint is the visible channel; aria-pressed is the spoken one —
                   the shelf rows are the same filter control as the status chips. Every
                   shelf among the chosen filters is lit; a click shows that shelf alone. *@
                var isActive = LibraryState.SelectedFilters.Contains(shelf.Filter);
                <button type="button"
                        class="shelf @(isActive ? "shelf--active" : null) @(shelf.IsAttention ? "shelf--attention" : null)"
                        @key="shelf.Filter"
                        aria-pressed="@isActive.ToAriaState()"
                        @onclick="() => SelectShelfAsync(shelf.Filter)">
                    <span class="shelf__label">@shelf.Label</span>
                    <span class="shelf__count tabular">@shelf.Count@(shelf.CountSuffix)</span>
                </button>
            }
        }
    </div>

    <div class="bottom">

        @* Only the link: the page itself is the profile screen's. *@
        <NavLink class="nav__row" ActiveClass="nav__row--active" href="profile">
            <Icon Name="IconName.User" Size="16" />
            <span class="nav__label">Profile</span>
        </NavLink>

        @* Short on purpose: the run's own numbers (design.md: transparent, not magical)
           live in the tooltip rather than as five lines of fine print. *@
        @if (LatestSync is { } latest)
        {
            @* "N to review" is a link to the review list: the count is only useful if it leads
               somewhere the questions can be read. *@
            <p class="sync" title="@latest.Detail">
                <SignalDot Tone="latest.Tone(Now)" />
                <span>
                    @latest.Headline(Now)@latest.FailureClause
                    @if (latest.ToReview.Count > 0)
                    {
                        @* A C# string, not markup: Razor drops the whitespace between the clause
                           above and this block, so the separator carries its own leading space. *@
                        @(" · ")<NavLink class="sync__review" href="review">@latest.ToReview.Count to review</NavLink>
                    }
                </span>
            </p>
        }
        else
        {
            <p class="sync" title="@SyncStatusText.NeverSyncedDetail">
                <SignalDot Tone="SignalTone.Quiet" />
                <span>@SyncStatusText.NeverSyncedHeadline</span>
            </p>
        }

        @* As quiet as the links below it: syncing by hand is the exception, the nightly run the
           rule. While a run started here is going, the note above already says so. *@
        <div class="sync__now">
            <button type="button" class="foot__link foot__button" disabled="@SyncState.IsFollowingRun"
                    @onclick="OnSyncNowAsync">
                @(SyncState.IsFollowingRun ? "Syncing…" : "Sync now")
            </button>
            @if (SyncState.Notice is { } notice)
            {
                <span class="sync__notice" role="status">@notice</span>
            }
        </div>

        @* Quiet on purpose — real pages with real routes, but not shelf navigation. *@
        <div class="foot">
            <NavLink class="foot__link" href="changelog">Changelog</NavLink>
            <a class="foot__link" href="privacy.html">Privacy</a>
            <button type="button" class="foot__link foot__button" @onclick="OnSignOutAsync">Sign out</button>
        </div>

    </div>

</aside>
