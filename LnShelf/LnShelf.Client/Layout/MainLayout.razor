@inherits LayoutComponentBase

@* First in the tab order and invisible until focused: one press takes a keyboard past the
   navigation. A button rather than an href="#main": the base href is "/", so a fragment
   link resolves to the library from every other page. *@
<button type="button" class="skip-link" @onclick="SkipToContentAsync">Skip to content</button>

<div class="app">
    <Sidebar />
    <main class="main" id="main" tabindex="-1" @ref="_mainElement">
        <div class="main__content">
            @Body
        </div>
    </main>
    @* Phones only; the sidebar is the navigation everywhere else. *@
    <MobileTabBar />
</div>
