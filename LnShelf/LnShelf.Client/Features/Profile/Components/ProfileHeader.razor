@using LnShelf.Shared.Auth
@using LnShelf.Client.Features.Profile

@* The avatar is the user's picture on the disc (their Google picture, or one they uploaded),
   or the initial when there is none. There is no handle to show (see CurrentUserResponse). *@

<header class="header">
    <div class="header__avatar title-page" aria-hidden="true"><ProfileAvatar User="User" /></div>

    <div class="header__text">
        <h1 class="title-page">@User.DisplayName</h1>
        <p class="header__meta">@SinceText</p>
    </div>
</header>

@code {
    [Parameter] public required CurrentUserResponse User { get; set; }

    /// <summary>The earliest read date on the shelf, when any read volume carries one.</summary>
    [Parameter] public DateOnly? FirstReadAt { get; set; }

    // "Reading since" is the honest line when the shelf has dates; without any, the account's
    // age is the only date there is.
    private string SinceText => FirstReadAt is { } first
        ? $"Reading since {first.ToString("MMM yyyy", CultureInfo.InvariantCulture)}"
        : $"Member since {User.CreatedAt.ToString("MMM yyyy", CultureInfo.InvariantCulture)}";
}
