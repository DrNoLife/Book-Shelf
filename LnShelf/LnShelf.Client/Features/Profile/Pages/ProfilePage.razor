@page "/profile"
@using LnShelf.Client.Features.Profile.Components
@using LnShelf.Client.Features.Sharing.Components

@* The user page (design.md, Profile): who you are, what you have read, and the account.
   The left column is the reading record; the right column is for the cards that act on the
   account. The shelf-sharing card sits above the picture card, and that above the account card. No readers/followers card: there
   are no followers in the product. On a phone the same page is one column under a centred
   header, and ends with the settings list. *@

<div class="page">
    <div class="page__stack profile">

        <NavLink class="profile__back desktop-only" href="">
            <Icon Name="IconName.CaretLeft" Size="13" />
            <span>Back to library</span>
        </NavLink>

        @if (State.LoadFailed)
        {
            <h1 class="visually-hidden">Profile</h1>
            <p class="notice">Could not reach the API.</p>
        }
        else if (State.User is not { } user || State.Stats is not { } stats)
        {
            <h1 class="visually-hidden">Profile</h1>
            <p class="notice">Loading your profile…</p>
        }
        else
        {
            <ProfileHeader User="user" FirstReadAt="stats.FirstReadAt" />

            <ProfileTotals Stats="stats" ReadingSeries="State.Reading.Count" />

            <div class="profile__columns">
                <div class="profile__main">
                    <ReadingNowSection Cards="State.Reading" />
                    <YearByMonthChart Stats="stats" />
                    <RecentlyFinishedList Reads="stats.RecentlyRead" />
                </div>

                <div class="profile__aside">
                    <ShelfSharingCard />
                    <AvatarCard User="user" />
                    <AccountCard User="user" />
                </div>
            </div>

            @* A phone has no sidebar; its Import, Changelog, Privacy, sync note and Sign out
               are here instead (the mobile mockup's settings list). *@
            <div class="phone-only">
                <ProfileSettingsList Email="@user.Email" />
            </div>
        }

    </div>
</div>
