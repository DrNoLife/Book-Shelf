@page "/search"
@using LnShelf.Client.Features.Search.Components

@* Search & add: one large field, the format filter with a count per format, and the results
   grouped into works. Selecting a row opens its preview — a sticky panel beside the results on
   a wide screen, a bottom sheet on a phone — where "Start with" sets how far in the reader
   already is. On a phone the header is the sticky search bar, with Cancel beside the field. *@

<div class="search">
    <header class="search__head">
        <h1 class="search__title">Add a series</h1>

        @* On a phone the header is the sticky search bar; Import is reached from Profile there. *@
        <div class="desktop-only">
            <AddTabs Current="AddTab.Search" ReviewCount="ImportState.PendingReviewCount" />
        </div>

        <div class="search__bar">
            @* A form so Enter (and a phone keyboard's Search key) runs the search. Searching on
               every keystroke would spend the source's rate limit on half-typed words. *@
            <form class="search__form" role="search" @onsubmit="OnSubmitAsync" @onsubmit:preventDefault>
                <SearchField class="search__field"
                             Large
                             Value="@SearchState.Query"
                             ValueChanged="OnQueryChangedAsync"
                             Placeholder="Search by title…"
                             AriaLabel="Search by title"
                             ClearLabel="Clear search" />
            </form>
            <button type="button" class="ghost search__cancel phone-only" @onclick="Cancel">Cancel</button>
        </div>

        <div class="search__filters">
            <div class="desktop-only">
                <SegmentedControl TValue="string"
                                  Options="FormatOptions"
                                  Value="@FormatKey"
                                  ValueChanged="OnFormatChosen"
                                  AriaLabel="Format" />
            </div>
            <ChipGroup TValue="string"
                       class="phone-only search__chips"
                       Options="FormatOptions"
                       Value="@FormatKey"
                       ValueChanged="OnFormatChosen"
                       AriaLabel="Format" />
            <p class="search__note desktop-only">@SourceNote</p>
        </div>
    </header>

    <div class="search__body">
        <section class="search__results" aria-label="Results" @ref="_resultsSection">
            @* Always in the page, so a screen reader hears "Adding Overlord…" when it starts; a
               live region that appears together with its text is often not read at all. *@
            <p class="visually-hidden" role="status">@SearchState.AddingAnnouncement</p>

            @if (SearchState.Message is { } message)
            {
                <p class="notice notice--message" role="status">@message</p>
            }

            @* One line for the whole answer, not one per row: which source answered is a fact
               about the search, and repeating it beside every result would be noise. *@
            @if (SearchState.DegradedNote is { } degradedNote)
            {
                <p class="notice notice--quiet">@degradedNote</p>
            }

            @* Gated on the search alone. Adding a series also puts a request in flight, and
               gating this on "busy" meant pressing Add replaced the whole result list with
               "Searching…" until the POST came back. *@
            @if (SearchState.IsSearching)
            {
                <p class="notice"><BusyIndicator /> Searching…</p>
            }
            else if (SearchState.Works.Count > 0)
            {
                <p class="search__count">@ResultCountLine</p>

                @foreach (var work in SearchState.Works)
                {
                    <SearchWorkCard @key="work"
                                    Work="work"
                                    FormatFilter="SearchState.FormatFilter"
                                    SelectedResult="SelectedEntry?.Result"
                                    IsOnShelf="SearchState.IsOnShelf"
                                    IsBusy="SearchState.IsBusy"
                                    AddingResult="SearchState.AddingResult"
                                    IsAddTakingLong="SearchState.IsAddTakingLong"
                                    BatchProgress="@(ReferenceEquals(work, _batchWork) ? SearchState.BatchProgress : null)"
                                    Selected="OnSelectedAsync"
                                    Added="OnQuickAddAsync"
                                    AddAllRequested="entries => OnAddAllAsync(work, entries)" />
                }

                <p class="fine">Not what you meant? Try the Japanese or romanized title.</p>
                <p class="fine phone-only search__tip">Tap a row for details · + adds it straight away</p>
            }
            else if (SearchState.HasSearched && SearchState.Message is null)
            {
                @* Only an answer is an empty answer: a failed search also leaves no results,
                   and its failure is already printed above. *@
                <p class="notice">@EmptyLine</p>
                <p class="fine">Not what you meant? Try the Japanese or romanized title.</p>
            }
            else if (!SearchState.HasSearched)
            {
                @* The one wry line per view, in fine print. *@
                <p class="notice notice--quiet">
                    Nothing searched yet. Type a title — the shelf will not judge the taste.
                </p>
            }

            @* Hidden while a search is in flight, so the line does not jump about under
               "Searching…". *@
            @if (!SearchState.IsSearching)
            {
                <ManualSeriesForm SuggestedTitle="@SearchState.Query" SuggestedFormat="SearchState.FormatFilter" />
            }
        </section>

        @if (SelectedEntry is { } selected)
        {
            <aside class="search__preview" aria-label="Preview" @ref="_previewPanel">
                <SearchPreview Result="selected.Result"
                               SeriesId="SearchState.SeriesIdOf(selected.Result)"
                               IsBusy="SearchState.IsBusy"
                               IsAdding="SearchState.IsAddingResult(selected.Result)"
                               IsTakingLong="SearchState.IsAddTakingLong"
                               AddRequested="OnPreviewAddAsync" />
            </aside>
        }
    </div>
</div>

@if (_isSheetOpen && SelectedEntry is { } sheetEntry)
{
    <BottomSheet AriaLabel="Series details" Closed="CloseSheetAsync">
        <SearchPreview Result="sheetEntry.Result"
                       SeriesId="SearchState.SeriesIdOf(sheetEntry.Result)"
                       IsBusy="SearchState.IsBusy"
                       IsAdding="SearchState.IsAddingResult(sheetEntry.Result)"
                       IsTakingLong="SearchState.IsAddTakingLong"
                       AddRequested="OnPreviewAddAsync" />
    </BottomSheet>
}
