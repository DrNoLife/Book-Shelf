@* Unstyled on purpose: this is phase 1.2 plumbing, not the header search
   design.md specifies. It carries no scoped stylesheet so nothing here has to
   be unpicked when phase 3 builds the real surface. *@
<section>
    <p><strong>Add a series from AniList</strong> — provisional, unstyled.</p>

    <form @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <input type="search"
               placeholder="Search AniList…"
               aria-label="Search AniList for a series"
               value="@SearchState.Query"
               @oninput="OnQueryInput" />
        <button type="submit" disabled="@SearchState.IsBusy">Search</button>
    </form>

    @if (SearchState.Message is not null)
    {
        <p role="status">@SearchState.Message</p>
    }

    @if (SearchState.IsBusy)
    {
        <p>Working…</p>
    }

    @if (SearchState.Results.Count > 0)
    {
        <table>
            <thead>
                <tr>
                    <th scope="col">Title</th>
                    <th scope="col">Format</th>
                    <th scope="col">Status</th>
                    <th scope="col">Volumes</th>
                    <th scope="col">Started</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var result in SearchState.Results)
                {
                    <tr @key="result.AniListId">
                        <td>@result.TitleEnglish</td>
                        <td>@result.Format</td>
                        <td>@result.PublicationStatus</td>
                        @* AniList publishes no total for many ongoing series. *@
                        <td>@(result.VolumeCount?.ToString() ?? "unknown")</td>
                        <td>@(result.StartYear?.ToString() ?? "—")</td>
                        <td>
                            <button type="button"
                                    disabled="@SearchState.IsBusy"
                                    @onclick="() => AddAsync(result)">
                                Add
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (SearchState.HasSearched && !SearchState.IsBusy && SearchState.Message is null)
    {
        <p>AniList knows nothing by that name.</p>
    }
</section>
