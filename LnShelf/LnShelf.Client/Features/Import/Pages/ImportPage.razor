@page "/search/import"
@page "/import"
@using LnShelf.Client.Features.Import.Components

@* Import a file (design: Import.dc), the second tab of "Add a series" — under /search, so the
   sidebar's Search & add row and the phone's "+" both stay lit here. /import is kept for links
   from before the move. Upload, check the unsure ones, apply: nothing reaches the shelf before
   the last step. *@

<div class="page import">
    <div class="page__stack">

        <header class="import__head">
            <h1 class="import__title">Add a series</h1>
            <AddTabs Current="AddTab.Import" ReviewCount="ImportState.PendingReviewCount" />
        </header>

        <div class="import__body">
            <div class="import__main">
                <ImportDropZone IsBusy="ImportState.IsBusy" Submitted="OnFileSubmittedAsync" />
                <ImportSteps Current="CurrentStep" />

                @if (ImportState.Message is { } message)
                {
                    <p class="notice notice--message" role="status">@message</p>
                }

                @if (ImportState.IsMatching)
                {
                    <p class="notice" role="status">Reading the file and matching every series against AniList — this takes a moment.</p>
                }

                @if (CommitResult is { } commit)
                {
                    <p class="notice notice--message" role="status">
                        @commit.SeriesCreated added, @commit.SeriesUpdated already tracked,
                        @commit.VolumeStatesWritten volumes recorded@(commit.LocalOnlyVolumesCreated > 0
                            ? $", {commit.LocalOnlyVolumesCreated} of them AniList had never heard of" : "").
                    </p>
                }

                @if (Queue is not null)
                {
                    <ImportReview Queue="Queue"
                                  IsBusy="ImportState.IsBusy"
                                  Decided="OnDecidedAsync"
                                  CommitRequested="OnCommitAsync" />
                }
                else if (ImportState.RecentBatches.Count == 0 && !ImportState.IsBusy)
                {
                    @* The one wry line, in fine print. *@
                    <p class="fine">Nothing imported yet. Years of reading, one CSV away.</p>
                }
            </div>

            <ImportAside Batches="ImportState.RecentBatches" IsBusy="ImportState.IsBusy" Opened="OnOpenBatchAsync" />
        </div>

    </div>
</div>
