@* One series' worth of books, and the decision it needs. The reason is printed,
   not implied: "review this" without saying what is uncertain is not a question
   anyone can answer. *@

<article class="group @(Group.Status == ImportGroupStatus.NeedsReview ? "group--waiting" : null)">

    <div class="group__head">
        <div class="group__identity">
            <h3 class="group__title">@Group.SeriesTitle</h3>
            <p class="group__books tabular">
                @Group.RowCount books · vols @Group.VolumeSummary · @Group.ReadCount read
            </p>
        </div>

        <p class="group__state">
            <span class="group__status @StatusClass">@StatusLabel</span>
            @if (ReasonLine is not null)
            {
                <span class="group__reason">@ReasonLine</span>
            }
        </p>
    </div>

    @if (Group.Candidates.Count > 0)
    {
        <div class="group__candidates">
            @foreach (var candidate in Group.Candidates)
            {
                <ImportCandidateTile Candidate="candidate"
                                     IsSelected="candidate.AniListId == Group.MatchedAniListId"
                                     IsDisabled="IsCommitted || IsBusy"
                                     Selected="OnCandidateSelectedAsync"
                                     @key="candidate.AniListId" />
            }
        </div>
    }

    <div class="group__actions">
        @* The books themselves, on request. "vols 1–9, 12" above is the compressed
           claim; this is what it was compressed from, so a title the parser read wrongly
           is visible before anything reaches the shelf. Collapsed by default: eleven
           groups of nine rows each is a wall, not a review queue. *@
        <button type="button"
                class="secondary"
                aria-expanded="@IsRowsOpen.ToAriaState()"
                @onclick="ToggleRows">
            @RowsLabel
        </button>

        @* StoryGraph records no ownership at all, so this rule is doing real work
           and has to be visible and reversible where it applies. *@
        <button type="button"
                class="toggle @(Group.TreatReadAsOwned ? "toggle--on" : null)"
                aria-pressed="@Group.TreatReadAsOwned.ToAriaState()"
                disabled="@(IsCommitted || IsBusy)"
                @onclick="OnOwnershipToggledAsync">
            @(Group.TreatReadAsOwned ? "Read means owned" : "Read only, not owned")
        </button>

        <button type="button"
                class="secondary"
                disabled="@(IsCommitted || IsBusy || Group.Status == ImportGroupStatus.Skipped)"
                @onclick="OnSkippedAsync">
            Leave off the shelf
        </button>

        <button type="button" class="secondary" disabled="@(IsCommitted || IsBusy)" @onclick="ToggleManualSearch">
            @(IsSearchOpen ? "Close search" : "Search AniList")
        </button>
    </div>

    @if (IsRowsOpen)
    {
        <ul class="books">
            <li class="books__head" aria-hidden="true">
                <span class="cell cell--volume eyebrow">Volume</span>
                <span class="cell cell--title eyebrow">As the export wrote it</span>
                <span class="cell cell--read eyebrow">Read</span>
                <span class="cell cell--owned eyebrow">Owned</span>
            </li>

            @foreach (var row in Group.Rows)
            {
                <li class="book" @key="row.LineNumber">
                    <span class="cell cell--volume tabular @(row.VolumeNumber is null ? "cell--unparsed" : null)">
                        @VolumeLabel(row)
                    </span>
                    <span class="cell cell--title">@row.RawTitle</span>
                    <span class="cell cell--read">@ReadLabel(row)</span>
                    <span class="cell cell--owned">
                        @if (row.Owned)
                        {
                            @(row.OwnedFormat?.ToString() ?? "Owned")
                        }
                    </span>
                </li>
            }
        </ul>
    }

    @if (IsSearchOpen)
    {
        <div class="group__search">
            <form class="search" @onsubmit="RunSearchAsync" @onsubmit:preventDefault>
                <span class="search__icon"><Icon Name="IconName.MagnifyingGlass" Size="13" /></span>
                <input class="search__input"
                       type="search"
                       placeholder="Find the right series…"
                       aria-label="Search AniList for @Group.SeriesTitle"
                       value="@SearchQuery"
                       @oninput="OnSearchInput" />
                <button type="submit" class="primary" disabled="@IsSearching">Search</button>
            </form>

            @if (IsSearching)
            {
                <p class="group__note">Searching…</p>
            }
            else if (SearchResults.Count > 0)
            {
                <div class="group__candidates">
                    @foreach (var result in SearchResults)
                    {
                        <ImportCandidateTile Candidate="result"
                                             IsSelected="result.AniListId == Group.MatchedAniListId"
                                             IsDisabled="IsBusy"
                                             Selected="OnCandidateSelectedAsync"
                                             @key="result.AniListId" />
                    }
                </div>
            }
            else if (HasSearched)
            {
                <p class="group__note">AniList knows nothing by that name either.</p>
            }
        </div>
    }

</article>
