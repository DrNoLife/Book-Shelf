@page "/upcoming"
@using LnShelf.Client.Features.Upcoming.Components

@* "What do I need to buy?" (ui-spec §3). Out now first, because it is the only group
   something can be done about today; then the dated months; then what is known to exist
   without a date. The format tabs apply here too — LN and manga are different budgets. *@

<h1 class="upcoming__title">Upcoming</h1>

<div class="upcoming">

    <div class="upcoming__top">
        <p class="eyebrow">Upcoming@(Summary is { } summary ? $" · {summary}" : "")</p>
        <FormatTabs Selected="State.SelectedFormat" SelectedChanged="State.SelectFormatAsync" />
    </div>

    <div class="upcoming__body">
        @if (State.LoadFailed)
        {
            <p class="notice">Could not reach the API.</p>
        }
        else if (State.Response is not { } upcoming)
        {
            <p class="notice">Loading what is coming…</p>
        }
        else if (IsEmpty(upcoming))
        {
            <p class="notice">Nothing out that you don't own, and nothing announced. Caught up, for once.</p>
        }
        else
        {
            <div class="groups">
                <UpcomingGroup Heading="Out now, not owned" Kind="UpcomingGroupKind.OutNow" Entries="upcoming.OutNow" />
                <UpcomingGroup Heading="This month" Kind="UpcomingGroupKind.Dated" Entries="upcoming.ThisMonth" />
                <UpcomingGroup Heading="Next 3 months" Kind="UpcomingGroupKind.Dated" Entries="upcoming.NextThreeMonths" />
                <UpcomingGroup Heading="Later" Kind="UpcomingGroupKind.Dated" Entries="upcoming.Later" />
                <UpcomingGroup Heading="Announced, no date" Kind="UpcomingGroupKind.Announced" Entries="upcoming.Announced" />
            </div>

            @* The one wry line, and an honest one: dated groups are usually empty because
               no source this shelf can reach publishes future dates. *@
            <p class="notice notice--quiet upcoming__footer">
                Dates only appear where a catalogue has one. Publishers keep the future to themselves.
            </p>
        }
    </div>

</div>
