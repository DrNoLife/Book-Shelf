@using LnShelf.Shared.Releases

@* One group of the Upcoming view. Every line is the same shape — cover, badge, title,
   the volumes it is about — and only the last column changes with the group's meaning:
   Saxo and Faraos links where something can be bought now, the date where one is known, and the
   plain words "No date" where it is not. *@

@if (Entries.Count > 0)
{
    <section class="group" aria-labelledby="@HeadingId">
        <h2 class="group__heading eyebrow" id="@HeadingId">
            @Heading <span class="group__count tabular">· @Entries.Count</span>
        </h2>

        <ul class="lines">
            @foreach (var entry in Entries)
            {
                <li class="line" @key="Key(entry)">
                    <a class="line__cover" href="@($"/series/{entry.SeriesId}")" tabindex="-1" aria-hidden="true">
                        @if (entry.CoverObjectKey is { } coverObjectKey)
                        {
                            <img src="@ApiUrls.Cover(coverObjectKey)" alt="" loading="lazy" />
                        }
                    </a>

                    <span class="line__badge"><FormatBadge Value="entry.Format" /></span>

                    <span class="line__identity">
                        <a class="line__title" href="@($"/series/{entry.SeriesId}")">@entry.SeriesTitle</a>
                        <span class="line__volumes tabular">
                            @VolumeNumberText.Describe(entry.VolumeNumbers)@if (entry.VolumeTitle is { } volumeTitle)
                            {
                                <span class="line__volume-title"> · @volumeTitle</span>
                            }
                        </span>
                    </span>

                    <span class="line__when">
                        @switch (Kind)
                        {
                            case UpcomingGroupKind.OutNow:
                                @* The control says exactly what it does, and names the
                                   first volume it points at (design.md voice). *@
                                <span class="line__shops">
                                    <a class="secondary line__buy"
                                       href="@SaxoSearch.UrlFor(entry.SeriesTitle, entry.VolumeNumbers[0])"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        Vol @entry.VolumeNumbers[0] on Saxo <Icon Name="IconName.ArrowUpRight" Size="10" />
                                    </a>
                                    <a class="ghost line__buy"
                                       href="@FaraosSearch.UrlFor(entry.SeriesTitle, entry.Format)"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       aria-label="@($"{entry.SeriesTitle} at Faraos Cigarer")">
                                        Faraos <Icon Name="IconName.ArrowUpRight" Size="10" />
                                    </a>
                                </span>
                                break;
                            case UpcomingGroupKind.Dated when entry.ReleaseDate is { } releaseDate:
                                <span class="line__date tabular">@releaseDate.Full</span>
                                break;
                            default:
                                <span class="line__nodate">No date</span>
                                break;
                        }
                    </span>
                </li>
            }
        </ul>
    </section>
}

@code {
    [Inject]
    public required ApiUrlBuilder ApiUrls { get; set; }

    [Parameter]
    public required string Heading { get; set; }

    [Parameter]
    public required UpcomingGroupKind Kind { get; set; }

    [Parameter]
    public required IReadOnlyList<UpcomingEntryResponse> Entries { get; set; }

    private string HeadingId => $"upcoming-{Heading.Replace(' ', '-').ToLowerInvariant()}";

    // A series appears once per group except in the dated ones, where each volume is its
    // own line — so the first volume number completes the key.
    private static string Key(UpcomingEntryResponse entry) => $"{entry.SeriesId}-{entry.VolumeNumbers[0]}";
}
