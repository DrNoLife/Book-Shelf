@page "/series/{SeriesId:guid}"
@using LnShelf.Client.Features.Series.Components
@using LnShelf.Client.Features.Notifications.Components

<div class="page series">
    <div class="page__stack">

        <NavLink class="back desktop-only" href="">
            <Icon Name="IconName.CaretLeft" Size="14" />
            <span>Library</span>
        </NavLink>

        @* The phone's top row (the mobile mockup): back, and More for what the narrow page
           has no room to lay out. Both 44px icon buttons. *@
        <div class="top-bar phone-only">
            <a class="icon-button" href="" aria-label="Back to library">
                <Icon Name="IconName.CaretLeft" Size="22" />
            </a>
            <button type="button"
                    class="icon-button"
                    aria-label="More"
                    aria-haspopup="dialog"
                    aria-expanded="@_isActionsOpen.ToAriaState()"
                    disabled="@(Series is null)"
                    @ref="_moreButton"
                    @onclick="OpenActions">
                <Icon Name="IconName.DotsThree" Size="22" />
            </button>
        </div>

        @if (SeriesState.LoadFailed)
        {
            <p class="notice">Could not reach the API.</p>
        }
        @* The loaded series has to be *this* series: the container outlives the
           navigation, so following the hero's relation link used to leave the previous
           series' hero, counts and volume grid on screen under the new URL. *@
        else if (IsLoading || Series is null)
        {
            <p class="notice">Loading the series…</p>
        }
        else
        {
            @if (SeriesState.Message is { } message)
            {
                <p class="notice notice--warning">@message</p>
            }

            @* A preference that failed to save says so where the control that failed
               lives — silently reverting on the next load is the bug. *@
            @if (Preferences.Message is { } preferenceMessage)
            {
                <p class="notice notice--warning">@preferenceMessage</p>
            }

            <SeriesHero Series="Series" />

            <SeriesProgress Series="Series" />

            <VolumeGrid Series="Series" />

            @* Every disagreement the last sweep recorded for this series, side by side. The open
               ones are amber; the ones the usual rules or the reader settled are quiet, but they
               stay here because choosing a source is how a reader changes what a settled one
               says (design.md, "Series"). *@
            @if (_linkOutcome is { } linkOutcome)
            {
                <p class="notice" role="status">@linkOutcome</p>
            }

            @foreach (var conflict in SeriesState.Conflicts)
            {
                @* The link question is answered by finding the record, not by picking a value, so
                   it gets its own panel; once linked there is nothing left to show for it. *@
                @if (conflict.Field is SyncDiscrepancyField.SeriesLink)
                {
                    @if (conflict.NeedsReview)
                    {
                        <ReleaseLinkPanel @key="(conflict.Field, conflict.VolumeNumber)"
                                          Conflict="conflict"
                                          SeriesId="Series.SeriesId"
                                          IsPageBusy="SeriesState.IsSaving"
                                          Linked="OnLinkedAsync" />
                    }
                }
                else
                {
                    <SourceConflictPanel @key="(conflict.Field, conflict.VolumeNumber)"
                                         Conflict="conflict"
                                         IsBusy="SeriesState.IsSaving"
                                         Chosen="source => OnChooseSourceAsync(conflict, source)"
                                         ResetRequested="() => OnResetSourceAsync(conflict)" />
                }
            }

            @* Asks AniList after the page has drawn; renders nothing until it has something. *@
            <MoreByAuthor Series="Series" />

            @* NOTES left, SYNC right, as the mockup lays out the foot of the page. *@
            <div class="series__foot">
                <SeriesNotes Series="Series" />

                <aside class="sync">
                    <p class="eyebrow">Sync</p>
                    <p class="fine">@SyncLine</p>
                    <SeriesNotificationsToggle Series="Series" />
                </aside>
            </div>

            @* At the very foot, quiet, and saying what it costs before it is pressed —
               a destructive action should be findable, not prominent. *@
            <SeriesActionBar Series="Series" />

            @if (_isActionsOpen)
            {
                <SeriesActionsSheet Series="Series" Closed="CloseActionsAsync" DeleteRequested="OnDeleteFromSheetAsync" />
            }

            <section class="danger" aria-labelledby="danger-title">
                <div>
                    <h2 id="danger-title" class="title-panel">Remove from library</h2>
                    <p class="danger__fine">@DeleteCost</p>
                </div>
                @* Words, no icon: the icon set has no trash glyph, and inventing one that
                   nobody has looked at is worse than a label that cannot be misread. *@
                <button type="button"
                        class="destructive"
                        disabled="@SeriesState.IsSaving"
                        @onclick="OnDeleteAsync">
                    Remove from shelf
                </button>
            </section>
        }

    </div>
</div>
