@* What can be done to one volume: its reading status, whether and how it is owned, the Buy
   link when it is to buy, and its cover. One component in two frames — the popover beside a
   tile on a wide screen, the bottom sheet on a phone — so the two cannot drift apart.
   Reading and ownership are two independent choices, each always laid out (the segmented
   control's buttons carry aria-pressed), so nothing here has to be discovered. *@

<div class="details">
    <div class="field">
        <span class="eyebrow">Reading</span>
        <SegmentedControl TValue="ReadStatus"
                          Options="ReadOptions"
                          Value="Volume.ReadStatus"
                          ValueChanged="OnReadAsync"
                          Disabled="IsBusy"
                          AriaLabel="Reading status"
                          Stretch="true"
                          Inset="true" />

        @* When it was read — the tile's caption has no room for it and design.md fixes what
           may go there, so this is its home. A read volume's date is editable, because
           volumes marked read in a batch all carry the day they were ticked off. The date is
           saved when the input loses focus or Enter is pressed, never per keystroke: a
           desktop date input raises a change for every segment edited, and a half-typed
           date (an emptied segment, the year 0002 on the way to 2025) must not be saved. *@
        @if (Volume.ReadStatus is ReadStatus.Read)
        {
            <div class="read-date">
                <label class="read-date__label">
                    <span class="field__note">Read on</span>
                    <input class="read-date__input tabular"
                           type="date"
                           aria-label="Read date"
                           aria-invalid="@(_error is not null ? "true" : null)"
                           @ref="_readDateInput"
                           value="@ReadDateInput.Format(Volume.ReadAt)"
                           min="@ReadDateInput.EarliestText"
                           max="@ReadDateInput.Format(ReadDateInput.Today)"
                           @oninput="OnReadDateInput"
                           @onblur="CommitReadDateAsync"
                           @onkeydown="OnReadDateKeyDownAsync" />
                </label>

                @if (Volume.ReadAt is not null)
                {
                    <button type="button" class="ghost" disabled="@IsBusy" @onclick="OnReadDateClearedAsync">
                        Clear date
                    </button>
                }

                @if (_error is not null)
                {
                    <p class="read-date__error fine" role="alert">@_error</p>
                }
            </div>
        }
    </div>

    @* Where a chapter map gives the volume its chapters: "Ch. 98–103", or "Ch. 138–" while
       the next volume's start is unknown. The series page's chapter block carries the credit. *@
    @if (ChapterText.Range(Volume) is { } chapterRange)
    {
        <p class="fine tabular">@chapterRange</p>
    }

    @* Ownership and edition in one choice: "No" is not owned, and the other two are owned
       in that edition. The model already says exactly this (Owned plus OwnedFormat). *@
    <div class="field">
        <span class="eyebrow">On your shelf</span>
        <SegmentedControl TValue="Ownership"
                          Options="OwnershipOptions"
                          Value="CurrentOwnership"
                          ValueChanged="OnOwnershipAsync"
                          Disabled="IsBusy"
                          AriaLabel="Ownership"
                          Stretch="true"
                          Inset="true" />
    </div>

    @if (IsBuyable(Volume))
    {
        <a class="primary button--large" href="@SaxoSearch.UrlFor(SeriesTitle, Volume.Number)" target="_blank" rel="noopener noreferrer">
            Buy Vol @Volume.Number.ToVolumeText() on Saxo <Icon Name="IconName.ArrowUpRight" Size="12" />
        </a>
    }

    <div class="cover-actions">
        <button type="button" class="secondary" disabled="@IsBusy" @onclick="OnPickCoverAsync">
            @(Volume.HasCoverOverride ? "Replace cover…" : "Set cover…")
        </button>

        @if (Volume.HasCoverOverride)
        {
            <button type="button" class="ghost" disabled="@IsBusy" @onclick="OnRemoveCoverAsync">
                Remove cover
            </button>
        }

        @* Only a volume added by hand, on a series nothing syncs: a source's volume would come
           straight back. Confirmed first, because its read and owned state goes with it. *@
        @if (IsRemovable)
        {
            <button type="button" class="ghost" disabled="@IsBusy" @onclick="OnRemoveVolumeAsync">
                Remove volume
            </button>
        }
    </div>
</div>
