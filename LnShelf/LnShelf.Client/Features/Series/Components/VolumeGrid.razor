@* The centrepiece. The grid owns keyboard navigation because it is the only thing
   that knows the layout; the tiles own their own state and marks. *@

<section class="volumes">

    <header class="volumes__head">
        <div class="volumes__identity">
            <h2 class="volumes__title">Volumes</h2>
            <p class="volumes__count tabular">@CountLine</p>
        </div>

        <div class="volumes__controls">
            @* Printed, not hovered: design.md forbids hover-only information, and
               these are the only clues that a tile is interactive. *@
            <p class="volumes__hint">Click opens the menu · shift-click toggles owned · ←↑↓→ + space cycles read</p>

            <button type="button"
                    class="control @(SeriesState.IsSelectMode ? "control--on" : null)"
                    aria-pressed="@SeriesState.IsSelectMode.ToAriaState()"
                    @onclick="() => SeriesState.ToggleSelectMode()">
                @(SeriesState.IsSelectMode ? "Done" : "Select")
            </button>

            @if (SeriesState.IsSelectMode)
            {
                <button type="button" class="control" disabled="@(!HasSelection || SeriesState.IsSaving)"
                        @onclick="MarkSelectedReadAsync">
                    @MarkSelectedReadLabel
                </button>
                <button type="button" class="control" disabled="@(!HasSelection || SeriesState.IsSaving)"
                        @onclick="MarkSelectedOwnedAsync">
                    @MarkSelectedOwnedLabel
                </button>
            }
            else
            {
                @* The counts are computed into the labels, the way design.md computes
                   the next needed volume into "Vol 12 on Saxo". *@
                <button type="button" class="control" disabled="@(SeriesState.IsSaving || ReadThrough is null)"
                        @onclick="MarkReadThroughAsync">
                    Mark 1–@ReadThrough read
                </button>
                <button type="button" class="control" disabled="@(SeriesState.IsSaving || OwnedThrough is null)"
                        @onclick="MarkOwnedThroughAsync">
                    Mark 1–@OwnedThrough owned
                </button>
            }
        </div>
    </header>

    <div class="grid" @ref="_gridElement">
        @foreach (var volume in Series.Volumes)
        {
            <VolumeTile @ref="_tiles[volume.VolumeId]"
                        Volume="volume"
                        IsSelectMode="SeriesState.IsSelectMode"
                        IsSelected="SeriesState.SelectedVolumeIds.Contains(volume.VolumeId)"
                        IsInteractive="!SeriesState.IsSaving"
                        CoverVersion="SeriesState.CoverVersion"
                        MenuRequested="OnMenuRequestedAsync"
                        ReadCycled="OnReadCycledAsync"
                        OwnedToggled="OnOwnedToggledAsync"
                        SelectionToggled="OnSelectionToggled"
                        Navigated="OnNavigatedAsync"
                        CoverSelected="OnCoverSelectedAsync"
                        @key="volume.VolumeId" />
        }
    </div>

    @if (OpenVolume is { } openVolume && _placement is { } placement)
    {
        <VolumePopover Volume="openVolume"
                       Placement="placement"
                       IsBusy="SeriesState.IsSaving"
                       Closed="OnMenuClosedAsync"
                       CoverPickRequested="OnCoverPickRequestedAsync" />
    }

    @* The legend names every state in words, which is the channel that survives both
       grayscale and a screen reader. *@
    <div class="legend">
        <span class="legend__item"><span class="swatch swatch--read"></span>read</span>
        <span class="legend__item"><span class="swatch swatch--reading"></span>reading</span>
        <span class="legend__item"><span class="swatch swatch--owned"></span>owned, unread</span>
        <span class="legend__item"><span class="swatch swatch--tobuy"></span>to buy — dimmed and desaturated</span>
        <span class="legend__item"><span class="swatch swatch--unreleased"></span>not out yet</span>
    </div>

</section>
