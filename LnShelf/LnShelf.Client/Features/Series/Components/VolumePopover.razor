@* The volume's detail panel, shown as a popover. Fixed-positioned from a measured tile
   rect, so it escapes every ancestor's overflow and never reflows the grid it sits over.
   Reading and ownership are two independent choices, each always laid out (the segmented
   control's buttons carry aria-pressed), so nothing here has to be discovered. *@

<div class="panel-popover @(HasDescription ? "panel-popover--described" : null) @(Placement.FlippedVertically ? "panel-popover--above" : null)"
     style="left: @(Placement.Left.ToString("0.##", CultureInfo.InvariantCulture))px; top: @(Placement.Top.ToString("0.##", CultureInfo.InvariantCulture))px;"
     role="dialog"
     aria-label="@($"Volume {Volume.Number}")"
     @ref="_menuElement"
     @onkeydown="OnKeyDownAsync"
     @onfocusout="OnFocusOutAsync">

    <div class="head">
        <h3 class="head__title">Vol @Volume.Number</h3>
        @if (Volume.ReleaseDate is { } releaseDate)
        {
            <span class="head__date tabular">@releaseDate.Full</span>
        }
    </div>

    @* The date is the reader's pick of a source, not the usual rules' answer. *@
    @if (DateChoice is { } dateChoice)
    {
        <p class="fine">@ConflictText.ChoiceMarker(dateChoice)</p>
    }

    @* The volume's own blurb, where a source supplied one. Clamped, not scrolled: the
       panel's height is what decides its placement, so an unbounded region here would put
       the rows below it off the bottom of the screen. Nothing renders when there is no
       blurb — no placeholder, the same rule the caption's title follows. *@
    @if (DescriptionParagraphs.Count > 0)
    {
        <div class="blurb">
            @foreach (var paragraph in DescriptionParagraphs)
            {
                <p class="blurb__paragraph">@paragraph</p>
            }
        </div>
    }

    <div class="field">
        <span class="eyebrow">Reading</span>
        <SegmentedControl TValue="ReadStatus"
                          Options="ReadOptions"
                          Value="Volume.ReadStatus"
                          ValueChanged="OnReadAsync"
                          Disabled="IsBusy"
                          AriaLabel="Reading status"
                          Stretch="true"
                          Inset="true" />

        @* When it was read, where the shelf knows — the tile's caption has no room for it
           and design.md fixes what may go there, so this is its home. *@
        @if (Volume.ReadAt is { } readAt)
        {
            <span class="field__note tabular">Read @readAt.Full</span>
        }
    </div>

    @* Ownership and edition in one choice: "No" is not owned, and the other two are owned
       in that edition. The model already says exactly this (Owned plus OwnedFormat). *@
    <div class="field">
        <span class="eyebrow">On your shelf</span>
        <SegmentedControl TValue="Ownership"
                          Options="OwnershipOptions"
                          Value="CurrentOwnership"
                          ValueChanged="OnOwnershipAsync"
                          Disabled="IsBusy"
                          AriaLabel="Ownership"
                          Stretch="true"
                          Inset="true" />
    </div>

    @if (CanBuy)
    {
        <a class="primary button--large" href="@SaxoSearch.UrlFor(SeriesTitle, Volume.Number)" target="_blank" rel="noopener noreferrer">
            Buy Vol @Volume.Number on Saxo <Icon Name="IconName.ArrowUpRight" Size="12" />
        </a>
    }

    <div class="cover-actions">
        <button type="button" class="secondary" disabled="@IsBusy" @onclick="OnPickCoverAsync">
            @(Volume.HasCoverOverride ? "Replace cover…" : "Set cover…")
        </button>

        @if (Volume.HasCoverOverride)
        {
            <button type="button" class="ghost" disabled="@IsBusy" @onclick="OnRemoveCoverAsync">
                Remove cover
            </button>
        }
    </div>

    <p class="foot">Shift-click a volume to toggle owned. Or drop an image straight onto the tile.</p>
</div>
