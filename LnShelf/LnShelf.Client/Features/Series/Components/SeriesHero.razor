@* The hero: cover left, identity, status control and links right. The numbers live in
   the progress panel beneath it (SeriesProgress). *@
@inject ApiUrlBuilder ApiUrl

<header class="hero">

    <div class="hero__cover">
        <div class="cover">
            @if (Series.CoverObjectKey is { } coverObjectKey)
            {
                <img class="cover__art" src="@ApiUrl.Cover(coverObjectKey)" alt="" />
            }
            else
            {
                <span class="cover__label tabular">Vol @Series.Counts.Tracked</span>
            }
        </div>
        <p class="hero__caption desktop-only">Cover shows latest volume</p>
    </div>

    <div class="hero__body">

        <div class="hero__meta">
            <FormatBadge Value="Series.Format" />
            @if (CreditsLine is { } credits)
            {
                <span>@credits</span>
            }
            @if (YearLine is { } year)
            {
                <span aria-hidden="true">·</span>
                <span>@year</span>
            }
            <span aria-hidden="true">·</span>
            <span class="hero__status">
                <StatusDot Value="Series.PublicationStatus" />
                <span>@Series.PublicationStatus.Words</span>
            </span>
            @if (Series.ChoiceFor(SyncDiscrepancyField.Status) is { } statusChoice)
            {
                <span class="fine">@ConflictText.ChoiceMarker(statusChoice)</span>
            }
        </div>

        <h1 class="hero__title title-page">@Series.TitleEnglish</h1>
        @if (SubtitleLine.Length > 0)
        {
            <p class="hero__subtitle">@SubtitleLine</p>
        }

        @if (Series.Genres.Count > 0)
        {
            <div class="tags desktop-only">
                @foreach (var genre in Series.Genres)
                {
                    <span class="tag" @key="genre">@genre</span>
                }
            </div>
        }

        @* The synopsis, in body text under the identity block. Nothing renders when no
           source has one — an empty "no description" line would be noise on every
           manual entry. *@
        @if (DescriptionParagraphs.Count > 0)
        {
            <div class="synopsis">
                <div class="synopsis__body @(IsDescriptionLong && !IsDescriptionExpanded ? "synopsis__body--clamped" : null)">
                    @foreach (var paragraph in DescriptionParagraphs)
                    {
                        <p class="synopsis__paragraph">@paragraph</p>
                    }
                </div>

                @* Quiet, and never hover-only (design.md): the toggle is a visible control
                   with a visible label, not a gradient the reader has to guess at.

                   aria-expanded is bound to a string, not the bool: Blazor drops a false
                   bool attribute entirely, and a missing aria-expanded is not "collapsed".
                   The note lives here rather than between the attributes, where a Razor
                   comment is emitted as an attribute name and throws at render. *@
                @if (IsDescriptionLong)
                {
                    <button type="button"
                            class="synopsis__toggle"
                            aria-expanded="@(IsDescriptionExpanded ? "true" : "false")"
                            @onclick="ToggleDescription">
                        @(IsDescriptionExpanded ? "Less" : "More")
                    </button>
                }
            </div>
        }

        <div class="hero__actions">
            <TrackingStatusControl Series="Series" />

            @* The CTA names the volume you actually need next (design.md). *@
            @* On a phone the Buy link is in the sticky action bar and the source links are in
               the More sheet (SeriesActionBar, SeriesActionsSheet), as the mockup lays out. *@
            @if (Series.Counts.NextToBuyNumber is { } nextToBuy)
            {
                <a class="primary button--large desktop-only" href="@SaxoSearchUrl(nextToBuy)" target="_blank" rel="noopener noreferrer">
                    Buy Vol @nextToBuy on Saxo <Icon Name="IconName.ArrowUpRight" Size="12" />
                </a>
            }
            @if (Series.AniListId is { } aniListId)
            {
                <a class="ghost button--large desktop-only" href="@($"https://anilist.co/manga/{aniListId}")" target="_blank" rel="noopener noreferrer">
                    AniList <Icon Name="IconName.ArrowUpRight" Size="11" />
                </a>
            }
            @if (Series.MangaUpdatesId is { } mangaUpdatesId)
            {
                <a class="ghost button--large desktop-only" href="@($"https://www.mangaupdates.com/series.html?id={mangaUpdatesId}")" target="_blank" rel="noopener noreferrer">
                    MangaUpdates <Icon Name="IconName.ArrowUpRight" Size="11" />
                </a>
            }
        </div>

        @if (Series.Relation is { } relation)
        {
            <p class="hero__relation">
                <span class="eyebrow">Relations</span>
                <FormatBadge Value="relation.Format" />
                <a class="hero__relation-link" href="@($"/series/{relation.SeriesId}")">
                    @RelationLabel(relation) <Icon Name="IconName.ArrowUpRight" Size="11" />
                </a>
                <span class="fine">
                    Tracked separately · @relation.Published out,
                    @(relation.Owned == 0 ? "none owned" : $"{relation.Owned} owned")
                </span>
            </p>
        }

    </div>

</header>
