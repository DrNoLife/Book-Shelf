@* The volume grid's other rendering: one line per volume, for the series where 42
   tiles are a wall rather than a shelf. Same state model, same menu — a row is the
   tile's information without its artwork. *@

<ul class="list">

    <li class="list__head" aria-hidden="true">
        <span class="cell cell--number eyebrow">Volume</span>
        <span class="cell cell--state eyebrow">State</span>
        <span class="cell cell--date eyebrow">Released</span>
        <span class="cell cell--owned eyebrow">Edition</span>
    </li>

    @foreach (var volume in Volumes)
    {
        var state = VolumeTileStateMap.For(volume);

        <li @key="volume.VolumeId">
            @* A button, not a row with a click handler: the menu it opens is the same
               menu the tile opens, so it has to be reachable the same way. *@
            <button type="button"
                    class="row @StateClass(state)"
                    data-volume="@volume.Number"
                    aria-haspopup="menu"
                    aria-label="@AccessibleLabel(volume, state)"
                    disabled="@(!IsInteractive)"
                    @onclick="args => OnClickAsync(args, volume)"
                    @onkeydown="args => OnKeyDownAsync(args, volume)">

                <span class="cell cell--number tabular">Vol @volume.Number</span>

                <span class="cell cell--state">
                    <span class="swatch"></span>
                    <span class="row__state-label">@VolumeTileStateMap.NameFor(state)</span>
                </span>

                <span class="cell cell--date tabular">
                    @if (volume.ReleaseDate is { } releaseDate)
                    {
                        @VolumeTileStateMap.FullDate(releaseDate)
                    }
                </span>

                <span class="cell cell--owned">
                    @if (volume.Owned)
                    {
                        @(volume.OwnedFormat?.ToString() ?? "Owned")
                    }
                </span>
            </button>
        </li>
    }

</ul>
