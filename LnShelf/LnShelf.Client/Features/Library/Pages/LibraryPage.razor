@page "/"
@using LnShelf.Client.Features.Library.Components

<div class="page library">
    <div class="page__stack">

        @* The page's name for a screen reader and for FocusOnNavigate; the sidebar and the
           header's eyebrow already name it for everyone else. *@
        <h1 class="visually-hidden">Library</h1>

        @* Two headers and two pairs of lists over one shelf: the desktop's (design.md, Library)
           and the phone's (the mobile mockup). Exactly one of each pair is displayed — the
           .desktop-only / .phone-only switch in app.css — and both read the same entries. *@
        @if (Library is not null)
        {
            <div class="desktop-only">
                <LibraryHeader Totals="Library.Totals" />
            </div>
            <div class="phone-only">
                <UpNextHeader Waiting="Library.Totals.Backlog" User="Profile.User" />
            </div>
        }

        @* The header always leads; the three sections under it follow the reader's order
           (Profile → Library), at every width alike. *@
        @foreach (var section in Preferences.LibrarySectionOrder)
        {
            @switch (section)
            {
                case LibrarySection.ContinueReading:
                    @if (ContinueEntries.Count > 0)
                    {
                        <div class="desktop-only">
                            <ContinueReading Entries="ContinueEntries" IsBusy="Finishing.IsBusy" Finished="OnFinishedAsync" />
                        </div>
                    }
                    @if (UpNextEntries.Count > 0)
                    {
                        <div class="phone-only">
                            <UpNextCarousel Entries="UpNextEntries" IsBusy="Finishing.IsBusy" Finished="OnFinishedAsync" />
                        </div>
                    }
                    break;

                case LibrarySection.OutNow:
                    @if (OutNowEntries.Count > 0)
                    {
                        <div class="desktop-only">
                            <OutNow Entries="OutNowEntries" />
                        </div>
                        <div class="phone-only">
                            <OutNowList Entries="AllOutNowEntries" />
                        </div>
                    }
                    break;

                case LibrarySection.Shelf:
                    <ShelfSection />
                    break;
            }
        }

    </div>
</div>

@* The receipt for "I finished Vol N", with its Undo — for the desktop card and the phone
   carousel alike. *@
<UndoToast />
