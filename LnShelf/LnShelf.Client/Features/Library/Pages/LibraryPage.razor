@page "/"
@using LnShelf.Client.Features.Library.Components
@using LnShelf.Shared.Preferences

<div class="page library">
    <div class="page__stack">

        @* The page's name for a screen reader and for FocusOnNavigate; the sidebar and the
           header's eyebrow already name it for everyone else. *@
        <h1 class="visually-hidden">Library</h1>

        @* Two headers and two pairs of lists over one shelf: the desktop's (design.md, Library)
           and the phone's (the mobile mockup). Exactly one of each pair is displayed — the
           .desktop-only / .phone-only switch in app.css — and both read the same entries. *@
        @if (Library is not null)
        {
            <div class="desktop-only">
                <LibraryHeader Totals="Library.Totals" />
            </div>
            <div class="phone-only">
                <UpNextHeader Waiting="Library.Totals.Backlog" Initial="@AvatarInitial" />
            </div>
        }

        @if (ContinueEntries.Count > 0)
        {
            <div class="desktop-only">
                <ContinueReading Entries="ContinueEntries" IsBusy="Finishing.IsBusy" Finished="OnFinishedAsync" />
            </div>
        }

        @if (UpNextEntries.Count > 0)
        {
            <div class="phone-only">
                <UpNextCarousel Entries="UpNextEntries" IsBusy="Finishing.IsBusy" Finished="OnFinishedAsync" />
            </div>
        }

        @if (OutNowEntries.Count > 0)
        {
            <div class="desktop-only">
                <OutNow Entries="OutNowEntries" />
            </div>
            <div class="phone-only">
                <OutNowList Entries="AllOutNowEntries" />
            </div>
        }

        <section class="shelf" aria-labelledby="shelf-title">
            <div class="section-head">
                <h2 id="shelf-title" class="title-section shelf__title">Shelf</h2>
                @if (Library is not null)
                {
                    <span class="section-head__aside phone-only tabular">@Library.Totals.Read read · @Library.Totals.Owned owned</span>
                }
            </div>

            @* The status filter as chips on a phone; the segmented control in the toolbar
               is the same filter on a wider screen. *@
            <div class="phone-only shelf__chips">
                <ShelfChips Selected="LibraryState.SelectedFilter" SelectedChanged="OnFilterSelectedAsync" />
            </div>

            <LibraryToolbar TextFilter="@LibraryState.TextFilter"
                            TextFilterChanged="OnTextFilterChanged"
                            Sort="LibraryState.Sort"
                            SortChanged="OnSortChangedAsync"
                            Density="Preferences.GridDensity"
                            DensityChanged="OnDensityChangedAsync"
                            View="Preferences.LibraryView"
                            ViewChanged="OnViewChangedAsync">
                <div class="desktop-only">
                    <StatusChips Selected="LibraryState.SelectedFilter" SelectedChanged="OnFilterSelectedAsync" />
                </div>
                <FormatTabs Selected="LibraryState.SelectedFormat" SelectedChanged="OnFormatSelectedAsync" />
            </LibraryToolbar>

            <GridLegend />

            @* A preference that failed to save says so where the control that failed lives
               — silently reverting on the next load is the bug. *@
            @if (Preferences.Message is { } preferenceMessage)
            {
                <p class="notice notice--warning">@preferenceMessage</p>
            }

            @if (LibraryState.LoadFailed)
            {
                <p class="notice">Could not reach the API.</p>
            }
            else if (Library is null)
            {
                <p class="notice">Loading the shelf…</p>
            }
            else if (Cards.Count == 0)
            {
                <p class="notice">
                    @if (!string.IsNullOrWhiteSpace(LibraryState.TextFilter))
                    {
                        @($"Nothing here matches “{LibraryState.TextFilter}”.")
                    }
                    else
                    {
                        @("Nothing on this shelf — and nothing hidden by a filter menu you forgot about.")
                    }
                </p>
            }
            else
            {
                @* Two renderings of the identical set: the chips, tabs, filter text and
                   sort have all been applied before either of these sees a card. *@
                @if (Preferences.LibraryView == LibraryView.Rows)
                {
                    <SeriesRows Cards="Cards" />
                }
                else
                {
                    <div class="@GridDensityClass">
                        @foreach (var card in Cards)
                        {
                            <SeriesCard Card="card" @key="card.SeriesId" />
                        }
                    </div>
                }

                @* Counts honestly: when a filter is narrowing the view, the line says
                   what is hidden rather than quietly reporting a smaller number. *@
                <p class="fine">
                    @FooterCount shown · @SortLabel · Numbers under each cover: read · owned · out.
                </p>
            }
        </section>

    </div>
</div>

@* The receipt for "I finished Vol N", with its Undo — for the desktop card and the phone
   carousel alike. *@
<UndoToast />
