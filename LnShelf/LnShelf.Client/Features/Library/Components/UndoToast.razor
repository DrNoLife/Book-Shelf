@* "Vol 18 marked read · Undo" (or "Ch. 143 marked read"): the receipt for a one-click write,
   with the way back on it. The live region is always in the DOM and only its content comes and goes, which is what
   makes a screen reader announce it; a region inserted together with its text is often
   missed. It withdraws itself after a few seconds — the undo is for the slip of a thumb,
   not a history. *@

<div class="toast-region" role="status">
    @if (State.LastFinished is { } finished)
    {
        <div class="toast" @key="finished">
            <span class="toast__text">@finished.Label marked read</span>
            <button type="button" class="secondary" disabled="@State.IsBusy" @onclick="UndoAsync">
                Undo<span class="visually-hidden"> marking @finished.Label of @finished.SeriesTitle read</span>
            </button>
        </div>

        @* The chapter just recorded finished a volume whose end a chapter map knows: offered on
           the same toast, so the one place a thumb is already looking carries the next step. *@
        @if (State.Offer is { } offer)
        {
            <div class="toast" @key="offer">
                <span class="toast__text">@ChapterText.FinishedOffer(offer.VolumeNumbers)</span>
                <button type="button" class="secondary" disabled="@State.IsBusy" @onclick="AcceptOfferAsync">
                    Mark read<span class="visually-hidden">: @ChapterText.VolumesLabel(offer.VolumeNumbers) of @offer.SeriesTitle</span>
                </button>
            </div>
        }
    }
    else if (State.Message is { } message)
    {
        <div class="toast">
            <span class="toast__text">@message</span>
            <button type="button" class="secondary" @onclick="State.Dismiss">Dismiss</button>
        </div>
    }
</div>
