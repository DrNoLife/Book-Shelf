@* The shelf's controls, kept to one calm bar: the title filter and a Filters button, then
   one quiet line of what is hiding series, how many are showing and the colour key. Status,
   format, sort, view and density live in the panel the button opens; the sidebar's smart
   shelves remain the one-click status switch on a desktop. Owner feedback 2026-10-10: the
   old toolbar laid every control out at once and overflowed a phone. *@

<div class="toolbar">

    <div class="toolbar__bar">
        <SearchField class="toolbar__search"
                     AriaLabel="Filter the shelf by title"
                     Placeholder="Filter by title"
                     ClearLabel="Clear the title filter"
                     Value="@TextFilter"
                     ValueChanged="TextFilterChanged" />

        <ShelfFilterButton ActiveCount="ActiveFilterCount">
            <ShelfFilterControls Status="Status"
                                 StatusChanged="StatusChanged"
                                 DefaultStatus="DefaultStatus"
                                 SaveDefaultRequested="SaveDefaultRequested"
                                 Format="Format"
                                 FormatChanged="FormatChanged"
                                 Sort="Sort"
                                 SortChanged="SortChanged"
                                 View="View"
                                 ViewChanged="ViewChanged"
                                 Density="Density"
                                 DensityChanged="DensityChanged" />
        </ShelfFilterButton>
    </div>

    <div class="toolbar__summary">
        <ActiveFilterChips Status="Status"
                           Format="Format"
                           HasTextFilter="@(!string.IsNullOrWhiteSpace(TextFilter))"
                           StatusRemoved="StatusRemoved"
                           FormatCleared="() => FormatChanged.InvokeAsync(null)"
                           ClearAllRequested="ClearAllRequested" />

        <div class="toolbar__aside">
            @* Polite, so a screen reader hears the new count after a filter lands without
               being interrupted mid-keystroke. *@
            <span class="toolbar__count" aria-live="polite">@CountText</span>

            <button type="button"
                    class="toolbar__key"
                    aria-expanded="@IsKeyOpen.ToAriaState()"
                    aria-controls="shelf-key"
                    @onclick="ToggleKeyAsync">
                Key
                <span class="toolbar__caret @(IsKeyOpen ? "toolbar__caret--open" : null)">
                    <Icon Name="IconName.CaretRight" Size="11" />
                </span>
            </button>
        </div>
    </div>

    @* Always in the document so the button's aria-controls points at something; hidden
       until asked for. The key is how the bars and dots stop being colour-only, so it is
       one tap away rather than gone. *@
    <div id="shelf-key" class="toolbar__key-panel" hidden="@(!IsKeyOpen)">
        <GridLegend />
    </div>

</div>
