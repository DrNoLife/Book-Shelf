@using LnShelf.Shared.Preferences

@* The header's working furniture: narrow the shelf, reorder it, tighten it, or add
   to it. Nothing here is a native control — see Dropdown and the density toggle. *@

<div class="bar">

    <div class="bar__field">
        <span class="bar__icon"><Icon Name="IconName.MagnifyingGlass" Size="13" /></span>
        <input class="bar__input"
               type="search"
               placeholder="Type to filter…"
               aria-label="Filter the shelf by title"
               value="@TextFilter"
               @oninput="OnTextInput" />
    </div>

    <div class="bar__group">
        <Dropdown Options="SortOptions"
                  Value="@Sort.ToString()"
                  ValueChanged="OnSortChangedAsync"
                  AriaLabel="Sort the shelf" />

        @* Two views of the same set. Words rather than icons: "rows" and "covers" are
           not shapes anyone recognises, and the quiet raised fill keeps this from
           competing with the format tabs' persimmon pill. *@
        <div class="toggle" role="group" aria-label="Library view">
            <button type="button"
                    class="toggle__button toggle__button--wide @(View == LibraryView.Rows ? "toggle__button--on" : "")"
                    aria-pressed="@((View == LibraryView.Rows).ToAriaState())"
                    title="Rows — one line per series"
                    @onclick="() => OnViewChangedAsync(LibraryView.Rows)">
                Rows
            </button>
            <button type="button"
                    class="toggle__button toggle__button--wide @(View == LibraryView.Covers ? "toggle__button--on" : "")"
                    aria-pressed="@((View == LibraryView.Covers).ToAriaState())"
                    title="Covers — the cover grid"
                    @onclick="() => OnViewChangedAsync(LibraryView.Covers)">
                Covers
            </button>
        </div>

        @* Two channels, not colour alone: the pressed button carries the raised fill
           and the icon differs between the two densities. Disabled rather than hidden in
           the rows view: a control that vanishes reads as a bug, one that says why it is
           inert does not. *@
        <div class="toggle" role="group" aria-label="Grid density">
            <button type="button"
                    class="toggle__button @(Density == GridDensity.Comfortable ? "toggle__button--on" : "")"
                    aria-pressed="@((Density == GridDensity.Comfortable).ToAriaState())"
                    disabled="@IsDensityDisabled"
                    title="@DensityTitle("Comfortable")"
                    @onclick="() => OnDensityChangedAsync(GridDensity.Comfortable)">
                <Icon Name="IconName.SquaresFour" Size="14" />
            </button>
            <button type="button"
                    class="toggle__button @(Density == GridDensity.Compact ? "toggle__button--on" : "")"
                    aria-pressed="@((Density == GridDensity.Compact).ToAriaState())"
                    disabled="@IsDensityDisabled"
                    title="@DensityTitle("Compact")"
                    @onclick="() => OnDensityChangedAsync(GridDensity.Compact)">
                <Icon Name="IconName.GridNine" Size="14" />
            </button>
        </div>

        <NavLink class="bar__add" href="search">
            <Icon Name="IconName.Plus" Size="13" />
            <span>Add series</span>
        </NavLink>
    </div>

</div>

@code {
    [Parameter] public string TextFilter { get; set; } = string.Empty;

    [Parameter] public EventCallback<string> TextFilterChanged { get; set; }

    [Parameter] public LibrarySort Sort { get; set; }

    [Parameter] public EventCallback<LibrarySort> SortChanged { get; set; }

    [Parameter] public GridDensity Density { get; set; }

    [Parameter] public EventCallback<GridDensity> DensityChanged { get; set; }

    [Parameter] public LibraryView View { get; set; }

    [Parameter] public EventCallback<LibraryView> ViewChanged { get; set; }

    /// <summary>Density is a grid setting, and the rows view has no grid.</summary>
    private bool IsDensityDisabled => View == LibraryView.Rows;

    private string DensityTitle(string density) =>
        IsDensityDisabled ? $"{density} — density applies to the covers view" : density;

    /// <summary>Labels say what the order is, not what the enum is called.</summary>
    private static readonly IReadOnlyList<DropdownOption> SortOptions =
    [
        new(nameof(LibrarySort.MostBehind), "Most behind"),
        new(nameof(LibrarySort.Alphabetical), "A–Z"),
        new(nameof(LibrarySort.RecentlyUpdated), "Recently synced"),
        new(nameof(LibrarySort.LastRead), "Last read"),
    ];

    private Task OnTextInput(ChangeEventArgs args) =>
        TextFilterChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);

    private Task OnSortChangedAsync(string value) =>
        SortChanged.InvokeAsync(Enum.Parse<LibrarySort>(value));

    private Task OnDensityChangedAsync(GridDensity density) => DensityChanged.InvokeAsync(density);

    private Task OnViewChangedAsync(LibraryView view) => ViewChanged.InvokeAsync(view);
}
