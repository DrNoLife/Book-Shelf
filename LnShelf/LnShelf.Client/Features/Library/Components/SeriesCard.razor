@* Covers do the talking: the card adds a badge, a dot, the bar and the three numbers.
   A card is a link, which is also what lets it have a hover response, since the hover
   has a tap equivalent (following the link). *@
@inject ApiUrlBuilder ApiUrl

<a class="card @(Card.HasNewVolume ? "card--new" : null)" href="@($"/series/{Card.SeriesId}")">

    <div class="cover">
        @if (Card.CoverObjectKey is { } coverObjectKey)
        {
            @* Always the local cover route, never the AniList CDN (design.md).
               alt is empty on purpose: the title sits right below in the DOM, so
               announcing it twice is noise to a screen reader. *@
            <img class="cover__art" src="@ApiUrl.Cover(coverObjectKey)" alt="" loading="lazy" />
        }
        else
        {
            <span class="cover__label tabular">Vol @CoverVolumeNumber</span>
        }

        <span class="cover__badge"><FormatBadge Value="Card.Format" /></span>

        @if (Card.HasNewVolume)
        {
            <span class="cover__new"><Pill Tone="PillTone.Attention">New · Vol @Card.Published</Pill></span>
        }

        <span class="cover__dot"><StatusDot Value="Card.PublicationStatus" /></span>
    </div>

    <ThreeSegmentBar Read="Card.Read" Owned="Card.Owned" Published="Card.Published" />

    @* Printed, not hovered: hover-only information is forbidden by design.md. *@
    <div class="card__counts">
        <span class="tabular" title="@($"{Card.Read} read · {Card.Owned} owned · {Card.Published} out")">
            @Card.Read · @Card.Owned · @Card.Published
        </span>

        @if (Card.ToBuy > 0)
        {
            <Pill Tone="PillTone.Buy">@Card.ToBuy to buy</Pill>
        }
        else if (Card.Backlog > 0)
        {
            <Pill Tone="PillTone.Neutral">@Card.Backlog unread</Pill>
        }
        else if (Card.Published > 0)
        {
            <Pill Tone="PillTone.Ok">Up to date</Pill>
        }
    </div>

    <h3 class="card__title title-card">@Card.TitleEnglish</h3>

</a>

@code {
    [Parameter] public required LibraryCardResponse Card { get; set; }

    /// <summary>
    /// The card shows the latest volume. Falls back to the newest tracked volume
    /// for a series with nothing released yet.
    /// </summary>
    private int CoverVolumeNumber => Card.Published > 0 ? Card.Published : Math.Max(1, Card.Tracked);
}
