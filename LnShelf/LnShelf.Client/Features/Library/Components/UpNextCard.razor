@inject ApiUrlBuilder ApiUrl

@* One series in the phone's "Up next" carousel: the volume to read next, big, and one button
   that marks it finished — or, on a series counted in chapters, the next chapter and "+1
   chapter". The button writes straight away — the toast's Undo is the way back, which is
   kinder to a thumb than a confirmation would be. *@

<article class="next">
    <div class="next__top">
        <div class="next__cover" aria-hidden="true">
            @if (Card.CoverObjectKey is { } coverObjectKey)
            {
                <img class="next__art" src="@ApiUrl.Cover(coverObjectKey)" alt="" loading="lazy" />
            }
            else
            {
                <span class="next__word">@CoverWord</span>
                <span class="next__number tabular">@CoverNumber.ToVolumeText()</span>
            }
        </div>

        <div class="next__body">
            <span class="next__kicker">
                <FormatBadge Value="Card.Format" />
                <span class="eyebrow tabular">@Eyebrow</span>
            </span>
            <h3 class="next__title"><a href="@($"/series/{Card.SeriesId}")">@Card.TitleEnglish</a></h3>
            @switch (Entry)
            {
                case NextVolumeEntry:
                    <span class="next__shelf">@ShelfText</span>
                    break;

                case NextChapterEntry when Card.LastChapterRead is { } lastChapterRead:
                    @* Two pieces that each keep together, so the narrow card breaks between them
                       rather than inside "90 to read". *@
                    <span class="next__chapter tabular">
                        <span class="next__chapter-part">@ChapterText.Position(lastChapterRead, Card.LatestChapter)</span>
                        @if (ChapterText.ToRead(Card.LatestChapter, lastChapterRead) is { } toRead)
                        {
                            <span class="next__chapter-part next__to-read">@toRead</span>
                        }
                    </span>
                    break;

                case NextChapterEntry:
                    <span class="next__chapter">No chapter recorded yet</span>
                    break;
            }
        </div>
    </div>

    @switch (Entry)
    {
        case NextVolumeEntry volume:
            <VolumeSegmentStrip Kinds="OutKinds"
                                HighlightedIndex="NextIndex(volume)"
                                AriaLabel="@($"{Card.Read} of {Card.Published} read")" />

            <button type="button"
                    class="tertiary button--thumb button--block"
                    disabled="@IsBusy"
                    @onclick="() => Finished.InvokeAsync(volume)">
                I finished Vol @volume.NextVolumeNumber.ToVolumeText()<span class="visually-hidden"> of @Card.TitleEnglish</span>
            </button>
            break;

        case NextChapterEntry chapter:
            @* No volume strip: the reader counts this series in chapters, and the shelf does not
               know which volume a chapter is in. *@
            <button type="button"
                    class="tertiary button--thumb button--block"
                    disabled="@IsBusy"
                    @onclick="() => Finished.InvokeAsync(chapter)">
                +1 chapter<span class="visually-hidden">: mark chapter @chapter.NextChapter.ToVolumeText() of @Card.TitleEnglish read</span>
            </button>
            break;
    }
</article>
