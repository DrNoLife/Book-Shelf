@* The status filter, as the shared segmented control. Terminology is fixed — To buy /
   Backlog / Behind / Up to date are never paraphrased. "All" is its own segment, which
   replaces the old dismiss mark on the active chip. *@

<SegmentedControl TValue="LibraryFilter"
                  Options="Options"
                  Value="Selected"
                  ValueChanged="SelectedChanged"
                  AriaLabel="Status filter" />

@code {
    [Parameter] public required LibraryFilter Selected { get; set; }

    [Parameter] public EventCallback<LibraryFilter> SelectedChanged { get; set; }

    private static readonly IReadOnlyList<SegmentedOption<LibraryFilter>> Options =
    [
        new(LibraryFilter.All, "All", "Everything on the shelf"),
        new(LibraryFilter.Behind, "Behind", "Something to buy or something to read"),
        new(LibraryFilter.Reading, "Reading", "Series you are reading"),
        new(LibraryFilter.Backlog, "Backlog", "Owned and unread"),
        new(LibraryFilter.UpToDate, "Up to date", "Nothing to buy and nothing to read"),
        new(LibraryFilter.Completed, "Completed", "Series you finished"),
        new(LibraryFilter.PlanToStart, "Plan to start", "Series you plan to start"),
        new(LibraryFilter.Dropped, "Dropped", "Series you dropped"),
    ];
}
