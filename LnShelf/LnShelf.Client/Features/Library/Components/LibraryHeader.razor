@* Numbers first, in the user's terms. The serif carries the figures; the prose
   line says what they mean without a single piece of jargon. *@

<header class="header">
    <div class="header__figures">
        <p class="eyebrow">Library · @Totals.SeriesCount series</p>

        <div class="header__stats">
            <StatFigure Value="@Totals.Read.ToString()" Label="read" Size="StatSize.Hero" />
            <StatFigure Value="@Totals.Owned.ToString()" Label="owned" Size="StatSize.Hero" />
            @* "Out" is the context for the other two, not the news, so it recedes. *@
            <StatFigure Value="@Totals.Published.ToString()" Label="out" Size="StatSize.Hero" Quiet="true" />
        </div>

        <p class="lead">
            @Totals.Backlog on your shelf waiting. @Totals.ToBuy out there you haven't bought.
        </p>
    </div>

    <NavLink class="primary button--large" href="search">
        <Icon Name="IconName.Plus" Size="16" />
        <span>Add series</span>
    </NavLink>
</header>

@code {
    /// <summary>Totals across the current format scope, not the filtered subset.</summary>
    [Parameter]
    public required LibraryTotals Totals { get; set; }
}
