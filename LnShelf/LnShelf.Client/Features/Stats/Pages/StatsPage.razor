@page "/stats"
@using LnShelf.Client.Features.Stats.Components

@* The StoryGraph wrap-up, but yours (design: Stats.dc / MStats.dc). The totals first; then
   the months and the pace they add up to; then the series furthest in, beside the formats and
   the spend. No backlog-over-time chart on purpose — see StatsResponse for why a trend line
   would be drawn from data the shelf does not have. The mockup's period switch (12 months ·
   this year · all time) and "Add dates" are left out until the API can answer them
   (design.md, Not built). *@

<div class="page stats">
    <div class="page__stack">

        <header class="stats__head">
            <h1 class="stats__title">Stats</h1>
        </header>

        @if (State.LoadFailed)
        {
            <p class="notice">Could not reach the API.</p>
        }
        else if (State.Response is not { } stats)
        {
            <p class="notice"><BusyIndicator /> Counting…</p>
        }
        else if (stats.Formats.Count == 0)
        {
            <p class="notice">Nothing on the shelf yet, so nothing to count.</p>
        }
        else
        {
            <section class="totals" aria-label="Totals">
                <div class="totals__cell"><StatFigure Value="@Count(Read(stats))" Label="volumes read" Stacked="true" /></div>
                <div class="totals__cell"><StatFigure Value="@Count(Owned(stats))" Label="on your shelf" Stacked="true" /></div>
                <div class="totals__cell"><StatFigure Value="@Count(Waiting(stats))" Label="bought, waiting" Stacked="true" /></div>
                <div class="totals__cell">
                    <StatFigure Value="@($"{Count(stats.CompletedSeries)} / {Count(SeriesCount(stats))}")" Label="series finished" Stacked="true" />
                </div>
            </section>

            <div class="stats__row">
                <Panel class="stats__wide" aria-labelledby="stats-read">
                    <div class="section-head">
                        <h2 id="stats-read" class="stats__panel-title">Read per month</h2>
                        <span class="section-head__aside">@ChartNote(stats)</span>
                    </div>

                    <MonthBarChart Bars="ReadBars(stats)" AriaLabel="Volumes read per month, last twelve months" />

                    @if (stats.ReadWithoutDate > 0)
                    {
                        <p class="stats__undated">
                            <SignalDot Tone="SignalTone.Attention" />
                            <span>
                                @stats.ReadWithoutDate read @(stats.ReadWithoutDate == 1 ? "volume has" : "volumes have") no date,
                                so @(stats.ReadWithoutDate == 1 ? "it is" : "they are") counted but not charted.
                            </span>
                        </p>
                    }
                </Panel>

                <PaceCard Pace="ReadingPace.From(stats.ReadPerMonth)" Waiting="Waiting(stats)" />
            </div>

            <div class="stats__row stats__row--top">
                @if (stats.LongestSeries.Count > 0)
                {
                    <div class="stats__wide">
                        <FurthestIn Series="stats.LongestSeries" />
                    </div>
                }

                <div class="stats__side">
                    <FormatCard Formats="stats.Formats" />
                    <SpendCard Stats="stats" />
                </div>
            </div>
        }

    </div>
</div>
