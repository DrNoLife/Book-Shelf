@* Format is a first-class dimension, so it gets one tap, never a filter menu. It is the
   shared segmented control with the four format choices; nothing here is styled. *@

<SegmentedControl TValue="string"
                  Options="Options"
                  Value="@ToKey(Selected)"
                  ValueChanged="OnChosenAsync"
                  AriaLabel="Format" />

@code {
    /// <summary>Null is "All".</summary>
    [Parameter] public Format? Selected { get; set; }

    [Parameter] public EventCallback<Format?> SelectedChanged { get; set; }

    // The control's value type must not be nullable, so "All" is the empty key.
    private const string AllKey = "";

    private static readonly IReadOnlyList<SegmentedOption<string>> Options =
    [
        new(AllKey, "All", "All formats"),
        new(nameof(Format.LightNovel), "LN", "Light novels"),
        new(nameof(Format.Manga), "Manga", "Manga"),
        new(nameof(Format.WebNovel), "WN", "Web novels"),
    ];

    private static string ToKey(Format? format) => format?.ToString() ?? AllKey;

    private Task OnChosenAsync(string key) =>
        SelectedChanged.InvokeAsync(key.Length == 0 ? null : Enum.Parse<Format>(key));
}
