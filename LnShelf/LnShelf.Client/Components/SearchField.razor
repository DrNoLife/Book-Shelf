@* The filter / search input: a leading magnifier in --faint inside a --surf field. It is
   the library's "Filter by title" and the search page's "Search by title" — same control,
   different words. The root takes the caller's class for placement (a max width, a flex
   basis); the input has its own parameters. *@

<div @attributes="AdditionalAttributes" class="@CssClass">
    <span class="field__icon"><Icon Name="IconName.MagnifyingGlass" Size="@(Large ? 18 : 15)" /></span>
    <input class="field__input @(IsClearShown ? "field__input--clearable" : null)"
           type="search"
           id="@InputId"
           placeholder="@Placeholder"
           aria-label="@AriaLabel"
           value="@Value"
           @ref="_input"
           @oninput="OnInputAsync"
           @onkeydown="OnKeyDownAsync" />

    @* Our own clear mark: app.css removes the browser's, which can be neither styled nor named. *@
    @if (IsClearShown)
    {
        <button type="button" class="field__clear" aria-label="@ClearLabel" title="@ClearLabel" @onclick="ClearAsync">
            <Icon Name="IconName.Close" Size="13" />
        </button>
    }
</div>
