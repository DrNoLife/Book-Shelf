@* Phosphor icons, regular weight, vendored as inline paths — no icon font and
   no network request. Sized 12-16px and paired with text everywhere except nav
   and tile marks (docs/design.md). *@

<svg class="icon" width="@Size" height="@Size" viewBox="0 0 256 256"
     fill="currentColor" aria-hidden="true" focusable="false">
    <path d="@PathData" />
</svg>
