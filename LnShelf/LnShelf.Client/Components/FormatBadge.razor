@* One shared badge, one look for all three formats — the words (LN, Manga, WN) are what
   tell them apart, never a colour. It has to read both on a cover and on the page, so it
   is a dark pill with a hairline ring rather than a fill. *@

<span class="badge" title="@Title">@(Spelled ? SpelledLabel : Label)</span>

@code {
    /// <summary>The series format this badge names.</summary>
    [Parameter]
    public required Format Value { get; set; }

    /// <summary>
    /// The format in full capitals — "LIGHT NOVEL" — where there is room for it and nothing
    /// beside it says which format this is: the search preview. Same look, longer word.
    /// </summary>
    [Parameter]
    public bool Spelled { get; set; }

    private string SpelledLabel => Value switch
    {
        Format.LightNovel => "LIGHT NOVEL",
        Format.Manga => "MANGA",
        Format.WebNovel => "WEB NOVEL",
        _ => throw new ArgumentOutOfRangeException(nameof(Value), Value, "Unknown format."),
    };

    private string Label => Value switch
    {
        Format.LightNovel => "LN",
        Format.Manga => "Manga",
        Format.WebNovel => "WN",
        _ => throw new ArgumentOutOfRangeException(nameof(Value), Value, "Unknown format."),
    };

    private string Title => Value switch
    {
        Format.LightNovel => "Light novel",
        Format.Manga => "Manga",
        Format.WebNovel => "Web novel",
        _ => throw new ArgumentOutOfRangeException(nameof(Value), Value, "Unknown format."),
    };
}
