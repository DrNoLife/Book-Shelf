@typeparam TValue

@* The segmented control: one choice out of a few, always laid out. A --surf container,
   the chosen segment on --pressed. Deliberately neutral — the accent is for actions, and
   choosing a view or a filter is not one. Used for the format filter, the view toggles,
   the reading and ownership choices in a volume's panel. *@

<div class="toggle @(Stretch ? "toggle--stretch" : null) @(Inset ? "toggle--inset" : null)"
     role="group"
     aria-label="@AriaLabel">
    @foreach (var option in Options)
    {
        var isOn = EqualityComparer<TValue>.Default.Equals(option.Value, Value);

        <button type="button"
                class="toggle__button @(option.Label is null ? null : "toggle__button--wide") @(isOn ? "toggle__button--on" : null)"
                aria-pressed="@isOn.ToAriaState()"
                disabled="@Disabled"
                title="@TitleFor(option)"
                aria-label="@(option.Label is null ? option.Title : null)"
                @onclick="() => OnChosenAsync(option.Value)">
            @if (option.Icon is { } icon)
            {
                <Icon Name="icon" Size="14" />
            }
            @option.Label
            @if (option.Detail is { } detail)
            {
                <span class="toggle__detail">@detail</span>
            }
        </button>
    }
</div>
