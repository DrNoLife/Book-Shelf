@typeparam TValue

@* The quiet segmented control design.md specifies for the view toggles: a --surf
   container, the chosen segment raised. Deliberately not the format tabs' persimmon
   pill — a view choice must never compete with the scope tabs for the same signal. *@

<div class="toggle" role="group" aria-label="@AriaLabel">
    @foreach (var option in Options)
    {
        var isOn = EqualityComparer<TValue>.Default.Equals(option.Value, Value);

        <button type="button"
                class="toggle__button @(option.Label is null ? null : "toggle__button--wide") @(isOn ? "toggle__button--on" : null)"
                aria-pressed="@isOn.ToAriaState()"
                disabled="@Disabled"
                title="@TitleFor(option)"
                @key="option.Value"
                @onclick="() => OnChosenAsync(option.Value)">
            @if (option.Icon is { } icon)
            {
                <Icon Name="icon" Size="14" />
            }
            @option.Label
        </button>
    }
</div>
