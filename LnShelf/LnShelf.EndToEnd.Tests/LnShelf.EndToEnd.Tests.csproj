<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!-- Out of the default `dotnet test LnShelf.slnx` run on purpose: the unit suite
         stays fast and Docker-free, while these tests need Docker (Postgres through
         Testcontainers), a published client bundle and a Playwright browser. Run them
         with `-p:RunEndToEnd=true` (see CLAUDE.md Commands and the CI end-to-end job). -->
    <IsTestProject Condition="'$(RunEndToEnd)' != 'true'">false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- The captured AniList payloads the unit tests already map, linked rather than copied
       so the fake metadata source answers with exactly what AniList returned. -->
  <ItemGroup>
    <Content Include="..\LnShelf.Api.Tests\Features\Metadata\Fixtures\anilist-*.json"
             LinkBase="Fixtures"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\*.csv;Fixtures\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LnShelf.Api\LnShelf.Api.csproj" />
  </ItemGroup>

</Project>
