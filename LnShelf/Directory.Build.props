<Project>

  <!-- One place for the properties CLAUDE.md requires of every project:
       nullable on, warnings are errors (a warning is a defect). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- The app version, in ONE place. It stamps every assembly in the solution.
         Keep it equal to the newest entry in LnShelf.Api\Features\Changelog\Services\
         ChangelogCatalog.cs, which is what GET /api/changelog reports —
         ChangelogCatalogTests enforces that mechanically. Pre-1.0 scheme: bump the
         MINOR for a feature batch, the PATCH for a fix-only batch. Releasing a batch is:
         add the changelog entry, bump this. -->
    <Version>0.31.0</Version>

    <!-- TreatWarningsAsErrors only covers the compiler. MSBuild warnings —
         assembly version conflicts, NuGet audit advisories — are defects by the
         same standard, so they fail the build too. -->
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
  </PropertyGroup>

</Project>
